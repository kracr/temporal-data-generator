SubDataPropertyOf(:hasRegistrationDeadline :hasDeadline)

# Data Property: <https://anonymous.com/AcademicConferenceEvent#hasStartDate> (<https://anonymous.com/AcademicConferenceEvent#hasStartDate>)

DataPropertyDomain(:hasStartDate <http://w3id.org/daselab/onto/event#Event>)
DataPropertyRange(:hasStartDate xsd:dateTimeStamp)

# Data Property: <https://anonymous.com/AcademicConferenceEvent#hasStatus> (<https://anonymous.com/AcademicConferenceEvent#hasStatus>)

AnnotationAssertion(rdfs:comment :hasStatus "Announced, Approaching, TakingPlace, Over")
DataPropertyDomain(:hasStatus :AcademicEvent)
DataPropertyRange(:hasStatus xsd:string)

# Data Property: <https://anonymous.com/AcademicConferenceEvent#hasSubmissionDeadline> (<https://anonymous.com/AcademicConferenceEvent#hasSubmissionDeadline>)

SubDataPropertyOf(:hasSubmissionDeadline :hasDeadline)

# Data Property: <https://anonymous.com/AcademicConferenceEvent#hasTheme> (<https://anonymous.com/AcademicConferenceEvent#hasTheme>)

DataPropertyRange(:hasTheme xsd:string)

# Data Property: <https://anonymous.com/AcademicConferenceEvent#hasTitle> (<https://anonymous.com/AcademicConferenceEvent#hasTitle>)

DataPropertyRange(:hasTitle xsd:string)

# Data Property: <https://anonymous.com/AcademicConferenceEvent#hasVenue> (<https://anonymous.com/AcademicConferenceEvent#hasVenue>)

SubDataPropertyOf(:hasVenue owl:topDataProperty)
DataPropertyRange(:hasVenue xsd:string)

# Data Property: <https://anonymous.com/AcademicConferenceEvent#hasWebsiteURL> (<https://anonymous.com/AcademicConferenceEvent#hasWebsiteURL>)

DataPropertyRange(:hasWebsiteURL xsd:anyURI)

# Data Property: <https://anonymous.com/AcademicConferenceEvent#isRelatedTo> (<https://anonymous.com/AcademicConferenceEvent#isRelatedTo>)

AnnotationAssertion(rdfs:comment :isRelatedTo "Every aacdemic manuscript is related to some topic. For example AI")



